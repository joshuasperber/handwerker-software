# ── Supabase (Produktion + lokale Entwicklung ohne Docker) ──
# Dashboard → Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (Port 6543, mit ?pgbouncer=true)
# Host aus Supabase → Project Settings → Database → Connect (oft aws-0-… oder aws-1-…):
DATABASE_URL="postgresql://postgres.PROJECT_REF:DEIN_DB_PASSWORT@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="dein-anon-key"
# Legacy-Alias (falls schon gesetzt):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="dein-publishable-key"
# Dashboard → Project Settings → API → service_role (geheim, nur Server!)
SUPABASE_SERVICE_ROLE_KEY="dein-service-role-key"

# Groq (optional — Betriebsassistent formuliert Antworten natürlicher)
# Ohne Key funktioniert der Assistent mit strukturierten App-Daten.
# Gleicher Key wie in anderen Apps ist ok; Limits teilen sich pro Groq-Organisation/Modell.
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.1-8b-instant"

# Fallback (optional): OpenAI statt Groq
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL=""

JWT_SECRET="change-me-in-production-use-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3003"
# Für Passwort-Reset: In Supabase → Authentication → URL Configuration
#   Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs += http://localhost:3003/passwort-setzen (und Prod-URL)

# ── Datei-/Foto-Speicher (S3-kompatibel) ──
# Lokale Entwicklung mit MinIO (Bucket wird beim ersten Upload automatisch angelegt):
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="jomaster-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/jomaster-uploads"

# Produktion (empfohlen): Supabase Storage (S3-kompatibel)
#   Storage → Bucket "jomaster-uploads" anlegen
#   Project Settings → Storage → S3 Access Keys generieren
# S3_ENDPOINT="https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3"
# S3_REGION="eu-central-1"
# S3_BUCKET="jomaster-uploads"
# WICHTIG: Variable heißt S3_ACCESS_KEY (nicht S3_ACCES_KEY)
# S3_ACCESS_KEY="<supabase-s3-access-key-id>"
# S3_SECRET_KEY="<supabase-s3-secret-access-key>"
# S3_PUBLIC_URL=""

# E-Mail (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@jomaster.app"

# ── SMS (seven.io, nur Server — niemals NEXT_PUBLIC_) ──
# Konto: https://www.seven.io — API-Key unter Einstellungen → API
SEVEN_API_KEY=""
# Absendername, max. 11 Zeichen, z. B. JoMaster
SEVEN_SMS_FROM="JoMaster"
# Testmodus: kein echter Versand, nur Server-Log
# MESSAGING_DRY_RUN="true"

# Adresssuche / Geocoding (optional)
# Ohne Token: Photon (Komoot/OSM) über Server-Proxy – kostenlos, DE/AT/CH.
# Mit Token: Mapbox Geocoding (höhere Qualität / Limits), auch für Fahrtdistanz.
# MAPBOX_TOKEN=""

# Geplante Jobs (Vercel Cron). Wird von Vercel als "Authorization: Bearer <CRON_SECRET>"
# an /api/cron/daily gesendet. In Vercel als Environment Variable hinterlegen.
CRON_SECRET="change-me-long-random-string"

# Inngest (Background Jobs — optional, empfohlen für Prod)
# Vercel: https://www.inngest.com/docs/deploy/vercel — Integration installieren
# setzt INNGEST_SIGNING_KEY + INNGEST_EVENT_KEY automatisch.
# Lokal: INNGEST_DEV=1 npm run dev  +  npx inngest-cli@latest dev
# INNGEST_SIGNING_KEY=""
# INNGEST_EVENT_KEY=""
# INNGEST_DEV=1

# Sentry (Error-Tracking — optional)
# NEXT_PUBLIC_SENTRY_DSN="https://...@....ingest.sentry.io/..."
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
